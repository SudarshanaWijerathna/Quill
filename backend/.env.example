# Copy to backend/.env and adjust as needed.
ENVIRONMENT=development
DATABASE_URL=sqlite:///./quill.db

# REQUIRED in production: generate with
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-insecure-change-me
JWT_EXPIRE_MINUTES=1440

# Comma-separated browser origins allowed to call the API (production frontend URL).
CORS_ORIGINS=http://localhost:5173

# Session cookie (httpOnly JWT). For HTTPS deployments set COOKIE_SECURE=true.
# Only if frontend and API are on different sites: COOKIE_SAMESITE=none (requires COOKIE_SECURE=true).
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Development only: create demo users on startup (ignored when ENVIRONMENT=production).
SEED_DEMO_DATA=false
