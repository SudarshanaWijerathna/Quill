# Copy to frontend/.env.local and adjust as needed.

# Backend origin used by the built app. Leave empty in development:
# Vite proxies /api to the backend (see VITE_DEV_API_PROXY).
VITE_API_URL=

# Dev-only: where the Vite dev server proxies /api requests.
VITE_DEV_API_PROXY=http://localhost:8000

# Show the demo-account shortcuts on the login page (always shown in `npm run dev`).
VITE_SHOW_DEMO_ACCOUNTS=false
